{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["cuora"],
	"workspaces": {
		"apps/web": {
			"entry": [
				"alchemy.run.ts",
				"wrangler.jsonc",
				"wrangler.dev.jsonc",
				"src/routes.ts",
				"src/routes/**/*.{ts,tsx}",
				"src/test/**/*.{ts,tsx}",
				// Referenced from package.json scripts (dev:secrets runs
				// `cuora run -- node scripts/dev-secrets.mjs`, which knip's
				// script parser cannot see through the cuora wrapper).
				"scripts/**/*.{ts,mjs}"
			],
			// Resolved by @tailwindcss/vite through @ktbhealth/ui's globals.css.
			// pdfkit is pre-bundled via optimizeDeps.include in vite.config.ts
			// (SSR cold-start fix) — referenced by name, never imported here.
			"ignoreDependencies": ["tailwindcss", "pdfkit"]
		},
		"packages/db": {
			"entry": ["scripts/**/*.mjs"]
		},
		"packages/app-host": {
			// Ambient globals via /// <reference types> in src/env.d.ts.
			"ignoreDependencies": ["@cloudflare/workers-types"]
		},
		"infra/oci": {
			// pulumi/ is a standalone Pulumi program — not a workspace
			// member, with its own package.json/lockfile; its @pulumi/*
			// deps are intentionally not declared on @ktb/infra-oci.
			"ignore": ["pulumi/**"]
		},
		"plugins/notifications": {
			// Only referenced by generated src/route-types.d.ts
			// (`import type {} from "@tanstack/react-start"` / `AnyRoute`
			// from "@tanstack/react-router"`) and a
			// vi.mock("@tanstack/react-start/server") factory — no static
			// import for knip to count.
			"ignoreDependencies": ["@tanstack/react-start", "@tanstack/react-router"]
		}
	}
}
