{
	"name": "ktb",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "vp check",
		"lint": "vp lint",
		"format": "vp fmt",
		"test": "vp -C apps/web test",
		"deploy": "vp -C apps/web deploy",
		"cf-typegen": "bun --cwd apps/web cf-typegen",
		"db:generate": "bun --cwd packages/db db:generate",
		"db:migrate": "bun --cwd apps/web db:migrate",
		"db:migrate:local": "bun --cwd apps/web db:migrate:local",
		"db:studio": "bun --cwd packages/db db:studio"
	},
	"devDependencies": {
		"typescript": "^6.0.2",
		"vite-plus": "1.5.0"
	},
	"trustedDependencies": [
		"esbuild",
		"lightningcss",
		"msw",
		"workerd"
	]
}
