{
	"name": "ktb",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"plugins/*",
		"infra/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun --cwd apps/web dev",
		"dev:secrets": "bun --cwd apps/web dev:secrets",
		"build": "vp build",
		"preview": "vp preview",
		"check": "vp check",
		"lint": "vp lint",
		"format": "vp fmt",
		"test": "vp test",
		"deploy": "bun --cwd apps/web infra:deploy",
		"cf-typegen": "bun --cwd apps/web cf-typegen",
		"db:generate": "bun --cwd packages/db db:generate",
		"db:migrate": "bun --cwd apps/web db:migrate",
		"db:migrate:local": "bun --cwd apps/web db:migrate:local",
		"db:studio": "bun --cwd packages/db db:studio",
		"knip": "knip"
	},
	"devDependencies": {
		"@effect/ai-anthropic": "4.1.2",
		"@effect/ai-openai": "4.1.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "^31.0.0",
		"knip": "^6.44.2",
		"typescript": "^6.0.2",
		"vite-plus": "1.5.0",
		"vitest": "5.1.0"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.1.2"
	},
	"trustedDependencies": [
		"esbuild",
		"lightningcss",
		"msw",
		"workerd"
	]
}
