# Copy to `.env` (gitignored) and fill in. Never commit real values.

# Grafana admin credentials — the image defaults to admin/admin.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random

# Grafana public URL (used for absolute links in alerts/notifications).
# Point at the hostname cloudflared exposes for the UI.
GF_SERVER_ROOT_URL=https://ktb-grafana.luisfuturist.com

# Alert notification webhook — full ntfy topic URL
# (https://ntfy.sh/<long-random-topic>). The topic name is the only
# auth: generate a long random one and keep it secret. Leave empty to
# disable alert delivery (rules still evaluate in Grafana).
# Prod value lives in cuora: cuora://ktb/ntfy-url
NTFY_URL=

# --- Telemetry pipeline knobs (consumed by compose.yaml env) ---
# All backends retain 7 days (168h) — sized for the Always-Free VM's
# disk. To change retention, edit loki-config.yaml (retention_period +
# compactor), tempo-config.yaml (block_retention) and the Prometheus
# arg below together; keep them in sync.
PROMETHEUS_EXTRA_ARGS=--storage.tsdb.retention.time=7d
