# Copy to `.env` (gitignored) and fill in. Never commit real values.

# Grafana admin credentials — the image defaults to admin/admin.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random

# Grafana public URL (used for absolute links in alerts/notifications).
# Point at the hostname cloudflared exposes for the UI.
GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Telemetry pipeline knobs (consumed by compose.yaml env) ---
# Prometheus retention in days (default upstream is short; raise for prod).
PROMETHEUS_EXTRA_ARGS=--storage.tsdb.retention.time=30d

# Loki retention via compactor (filesystem store).
LOKI_EXTRA_ARGS=-compactor.retention-enabled=true -compactor.delete-request-store=filesystem -store.retention=720h
