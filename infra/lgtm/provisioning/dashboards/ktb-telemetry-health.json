			"id": 5,
			"title": "Telemetry pipeline errors by stage",
			"description": "All ktb_telemetry_errors_total series. export = OTLP push failures (telemetry lost at source); ingest = client-event ingest failures; flush = drain timeouts.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
