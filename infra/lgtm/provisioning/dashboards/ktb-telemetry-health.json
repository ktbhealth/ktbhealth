{
	"timezone": "browser",
	"editable": false,
	"graphTooltip": 1,
	"fiscalYearStartMonth": 0,
	"schemaVersion": 39,
	"templating": {
		"list": [
			{
				"type": "query",
				"name": "stage",
				"skipUrlSync": false,
				"multi": true,
				"allowCustomValue": true,
				"includeAll": true,
				"auto": false,
				"auto_min": "10s",
				"auto_count": 30,
				"label": "Error stage",
				"description": "Bounded stage label on ktb_telemetry_errors_total (ingest | export | flush).",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": "label_values(ktb_telemetry_errors_total, stage)",
				"refresh": 1,
				"sort": 1,
				"allValue": ".*"
			},
			{
				"type": "query",
				"name": "reason",
				"skipUrlSync": false,
				"multi": true,
				"allowCustomValue": true,
				"includeAll": true,
				"auto": false,
				"auto_min": "10s",
				"auto_count": 30,
				"label": "Drop reason",
				"description": "Bounded reason label on ktb_client_events_dropped_total (disabled | invalid | rate_limited | oversized | sampled).",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": "label_values(ktb_client_events_dropped_total, reason)",
				"refresh": 1,
				"sort": 1,
				"allValue": ".*"
			},
			{
				"type": "query",
				"name": "type",
				"skipUrlSync": false,
				"multi": true,
				"allowCustomValue": true,
				"includeAll": true,
				"auto": false,
				"auto_min": "10s",
				"auto_count": 30,
				"label": "Event type",
				"description": "Event type recorded on ktb_client_events_total (event | error | navigation | request).",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": "label_values(ktb_client_events_total, type)",
				"refresh": 1,
				"sort": 1,
				"allValue": ".*"
			}
		]
	},
	"annotations": {},
	"title": "KTB Platform — Telemetry Health",
	"uid": "ktb-telemetry-health",
	"description": "Health of the telemetry pipeline itself: OTLP export errors, client-event ingest/drops, Loki log volume and Tempo trace arrival. Complements the RED/USE dashboard — a green app with a dead pipeline still pages via the ktb-telemetry-absent dead-man alert.",
	"tags": [
		"ktb",
		"telemetry",
		"pipeline"
	],
	"time": {
		"from": "now-24h",
		"to": "now"
	},
	"refresh": "1m",
	"version": 1,
