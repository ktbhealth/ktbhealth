				"graphMode": "area",
				"colorMode": "value",
				"justifyMode": "auto",
				"textMode": "auto",
				"wideLayout": true,
				"showPercentChange": false,
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					]
				},
				"percentChangeColorMode": "standard",
				"orientation": "auto"
			},
			"id": 2,
			"title": "OTLP export errors (15m)",
			"description": "ktb_telemetry_errors_total{stage=\"export\"} increase over 15m. Counted per export attempt — retries can count more than once per batch. Alert: any sustained increase (ktb-telemetry-export-errors).",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 8,
				"h": 4
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "red",
								"value": 1
							}
						]
					}
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(increase(ktb_telemetry_errors_total{stage=\"export\"}[15m]))",
					"refId": "A",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"type": "stat",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"graphMode": "area",
				"colorMode": "value",
				"justifyMode": "auto",
				"textMode": "auto",
