{
	"timezone": "browser",
	"editable": false,
	"graphTooltip": 1,
	"fiscalYearStartMonth": 0,
	"schemaVersion": 39,
	"templating": {
		"list": [
			{
				"type": "query",
				"name": "type",
				"skipUrlSync": false,
				"multi": true,
				"allowCustomValue": true,
				"includeAll": true,
				"auto": false,
				"auto_min": "10s",
				"auto_count": 30,
				"label": "Event type",
				"description": "Event type on ktb_client_events_total (event | error | navigation | request).",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": "label_values(ktb_client_events_total, type)",
				"refresh": 1,
				"sort": 1,
				"allValue": ".*"
			},
			{
				"type": "query",
				"name": "reason",
				"skipUrlSync": false,
				"multi": true,
				"allowCustomValue": true,
				"includeAll": true,
				"auto": false,
				"auto_min": "10s",
				"auto_count": 30,
				"label": "Drop reason",
				"description": "Drop reason on ktb_client_events_dropped_total (disabled | invalid | rate_limited | oversized | sampled).",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": "label_values(ktb_client_events_dropped_total, reason)",
				"refresh": 1,
				"sort": 1,
				"allValue": ".*"
			}
		]
	},
	"annotations": {},
	"title": "KTB Platform — Client Telemetry",
	"uid": "ktb-client-events",
	"description": "Browser telemetry: events ingested at /api/telemetry (ktb_client_events_total), rejections (ktb_client_events_dropped_total) and the resulting client.* log records in Loki. Complements the Telemetry health dashboard with type/reason drill-downs.",
	"tags": [
		"ktb",
		"client",
		"telemetry"
	],
	"time": {
		"from": "now-24h",
		"to": "now"
	},
	"refresh": "1m",
	"version": 1,
	"links": [
		{
			"title": "Telemetry health",
			"type": "link",
			"icon": "",
			"tooltip": "",
			"tags": [],
			"asDropdown": false,
			"placement": "inControlsMenu",
			"targetBlank": false,
			"includeVars": true,
			"keepTime": true,
			"url": "/d/ktb-telemetry-health"
		},
		{
			"title": "RED/USE",
			"type": "link",
			"icon": "",
			"tooltip": "",
			"tags": [],
			"asDropdown": false,
			"placement": "inControlsMenu",
			"targetBlank": false,
			"includeVars": true,
			"keepTime": true,
			"url": "/d/ktb-platform"
		}
	],
	"panels": [
		{
			"type": "row",
			"collapsed": false,
			"id": 1,
			"panels": [],
			"title": "Overview",
			"gridPos": {
				"x": 0,
				"y": 0,
				"h": 1,
				"w": 24
			}
		},
		{
			"type": "stat",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"graphMode": "area",
				"colorMode": "value",
				"justifyMode": "auto",
				"textMode": "auto",
				"wideLayout": true,
				"showPercentChange": false,
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					]
				},
				"percentChangeColorMode": "standard",
				"orientation": "auto"
			},
			"id": 2,
			"title": "Client events ingested (1h)",
			"description": "ktb_client_events_total increase over the last hour — browser telemetry accepted at /api/telemetry.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 8,
				"h": 4
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(increase(ktb_client_events_total[1h]))",
					"refId": "A",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"type": "stat",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"graphMode": "area",
				"colorMode": "value",
				"justifyMode": "auto",
				"textMode": "auto",
				"wideLayout": true,
				"showPercentChange": false,
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					]
				},
				"percentChangeColorMode": "standard",
				"orientation": "auto"
			},
			"id": 3,
			"title": "Client events dropped (1h)",
			"description": "ktb_client_events_dropped_total increase over the last hour — events rejected before ingest (disabled | invalid | rate_limited | oversized | sampled).",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 1,
				"w": 8,
				"h": 4
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 50
							},
							{
								"color": "red",
								"value": 500
							}
						]
					}
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(increase(ktb_client_events_dropped_total[1h]))",
					"refId": "A",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"type": "stat",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"graphMode": "none",
				"colorMode": "value",
				"justifyMode": "auto",
				"textMode": "auto",
				"wideLayout": true,
				"showPercentChange": false,
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					]
				},
				"percentChangeColorMode": "standard",
				"orientation": "auto"
			},
			"id": 4,
			"title": "Drop ratio (1h)",
			"description": "dropped / (ingested + dropped) over the last hour. Sustained >5% suggests client payloads failing validation or the ingest rate cap being hit.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 16,
				"y": 1,
				"w": 8,
				"h": 4
			},
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 0.01
							},
							{
								"color": "red",
								"value": 0.05
							}
						]
					}
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(increase(ktb_client_events_dropped_total[1h])) / (sum(increase(ktb_client_events_total[1h])) + sum(increase(ktb_client_events_dropped_total[1h])))",
					"refId": "A",
					"range": true,
					"instant": false
				}
			]
		},
		{
			"type": "row",
			"collapsed": false,
			"id": 5,
			"panels": [],
			"title": "Rates",
			"gridPos": {
				"x": 0,
				"y": 5,
				"w": 24,
				"h": 1
			}
		},
		{
			"type": "timeseries",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true,
					"calcs": [
						"lastNotNull"
					]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "none"
				}
			},
			"fieldConfig": {
				"defaults": {
					"custom": {},
					"unit": "ops",
					"decimals": 2,
					"min": 0
				},
				"overrides": []
			},
			"id": 6,
			"title": "Client events ingested by type",
			"description": "ktb_client_events_total rate per event type: event (custom domain events), error (window errors/unhandled rejections), navigation (route changes), request (fetch/XHR instrumentation).",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 6,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (type) (rate(ktb_client_events_total{type=~\"$type\"}[$__rate_interval]))",
					"refId": "A",
					"range": true,
					"instant": false,
					"legendFormat": "{{type}}"
				}
			]
		},
		{
			"type": "timeseries",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true,
					"calcs": [
						"lastNotNull"
					]
				},
				"tooltip": {
					"mode": "multi",
					"sort": "none"
				}
			},
			"fieldConfig": {
				"defaults": {
					"custom": {},
					"unit": "ops",
					"decimals": 2,
					"min": 0
				},
				"overrides": []
			},
			"id": 7,
			"title": "Client events dropped by reason",
			"description": "ktb_client_events_dropped_total rate per reason. 'disabled' dominating means KTB_TELEMETRY_CLIENT is unset in the client env — check deployment config before treating as an incident.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 6,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (reason) (rate(ktb_client_events_dropped_total{reason=~\"$reason\"}[$__rate_interval]))",
					"refId": "A",
					"range": true,
					"instant": false,
					"legendFormat": "{{reason}}"
				}
			]
		},
		{
			"type": "row",
			"collapsed": false,
			"id": 8,
			"panels": [],
			"title": "Totals in range",
			"gridPos": {
				"x": 0,
				"y": 14,
				"w": 24,
				"h": 1
			}
		},
		{
			"type": "table",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"frameIndex": 0,
				"showHeader": true,
				"showTypeIcons": false,
				"footer": {
					"show": false,
					"reducer": [],
					"countRows": false
				},
				"cellHeight": "sm"
			},
			"fieldConfig": {
				"defaults": {
					"custom": {
						"align": "auto",
						"inspect": false
					}
				},
				"overrides": []
			},
			"id": 9,
			"title": "Events by type (selected range)",
			"description": "increase() over the dashboard time range, grouped by event type.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 15,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (type) (increase(ktb_client_events_total{type=~\"$type\"}[$__range]))",
					"refId": "A",
					"instant": true,
					"range": false
				}
			]
		},
		{
			"type": "table",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"frameIndex": 0,
				"showHeader": true,
				"showTypeIcons": false,
				"footer": {
					"show": false,
					"reducer": [],
					"countRows": false
				},
				"cellHeight": "sm"
			},
			"fieldConfig": {
				"defaults": {
					"custom": {
						"align": "auto",
						"inspect": false
					}
				},
				"overrides": []
			},
			"id": 10,
			"title": "Drops by reason (selected range)",
			"description": "increase() over the dashboard time range, grouped by drop reason.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 15,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (reason) (increase(ktb_client_events_dropped_total{reason=~\"$reason\"}[$__range]))",
					"refId": "A",
					"instant": true,
					"range": false
				}
			]
		},
		{
			"type": "row",
			"collapsed": false,
			"id": 11,
			"panels": [],
			"title": "Log records (Loki)",
			"gridPos": {
				"x": 0,
				"y": 23,
				"w": 24,
				"h": 1
			}
		},
		{
			"type": "logs",
			"transparent": false,
			"repeatDirection": "h",
			"options": {
				"showLabels": false,
				"showCommonLabels": false,
				"showTime": true,
				"showLogContextToggle": false,
				"wrapLogMessage": true,
				"prettifyLogMessage": false,
				"enableLogDetails": false,
				"sortOrder": "Descending",
				"dedupStrategy": "none"
			},
			"id": 12,
			"title": "client.* log records",
			"description": "Every ingested client event is re-emitted as a client.<type> log record with annotations (type, name, path, status, durationMs, event.message). Errors log at Error level — also match client.error.stack debug lines when expanded.",
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"gridPos": {
				"x": 0,
				"y": 24,
				"w": 24,
				"h": 10
			},
			"targets": [
				{
					"expr": "{service_name=\"ktb\"} |~ \"client\\.\"",
					"refId": "A",
					"range": true
				}
			]
		}
	]
}
