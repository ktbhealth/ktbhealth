				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ktb_http_requests_total{handlerType=~\"$handlerType\",status=~\"5..\"}[5m])) / sum(rate(ktb_http_requests_total{handlerType=~\"$handlerType\"}[5m]))",
