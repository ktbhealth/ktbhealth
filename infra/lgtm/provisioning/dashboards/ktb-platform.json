			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "yellow",
								"value": 0.01
							},
							{
								"color": "red",
								"value": 0.05
							}
