					"decimals": 2
				},
				"overrides": []
			},
			"targets": [
				{
					"expr": "sum(rate(ktb_http_requests_total{handlerType=~\"$handlerType\"}[$__rate_interval]))",
					"refId": "A",
					"range": true,
