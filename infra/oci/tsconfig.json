{
	"include": ["**/*.ts"],
	"exclude": ["pulumi"],
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUncheckedSideEffectImports": true,
		"types": ["node"]
	}
}
