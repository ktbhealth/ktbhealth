{
	"name": "@ktb/web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "CLOUDFLARE_ACCOUNT_ID=2c03574ae47e534415b762ab3c474815 vp dev --port 3000",
		"dev:secrets": "CLOUDFLARE_ACCOUNT_ID=2c03574ae47e534415b762ab3c474815 cuora run --config ../../cuora.toml -- vp dev --port 3000",
		"build": "vp build && node scripts/strip-oversized-assets.mjs",
		"preview": "vp preview",
		"test": "vp test",
		"deploy": "bun run infra:deploy",
		"cf-typegen": "wrangler types",
		"db:migrate": "wrangler d1 migrations apply ktb --remote",
		"db:migrate:local": "wrangler d1 migrations apply ktb --local",
		"infra:dev": "alchemy dev",
		"infra:deploy": "node ../../packages/db/scripts/sync-alchemy-migrations.mjs && cuora run --env prod --config ../../cuora.toml -- alchemy deploy --stage prod -y",
		"infra:destroy": "alchemy destroy --stage prod",
		"test:e2e": "playwright test",
		"test:coverage": "vp test",
		"db:seed": "bun scripts/seed-users.ts"
	},
