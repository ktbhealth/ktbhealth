{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ktb",
	"compatibility_date": "2026-11-06",
	// Custom worker entry: TanStack fetch pipeline + Cloudflare Queue
	// consumer for async audio transcription (see src/server.ts).
	"main": "./src/server.ts",
	"observability": {
		"enabled": true,
	},
	// Local dev only: this file is not used by the Alchemy deploy. Selects
	// @ktb/captcha-stub so credential endpoints pass without a real widget,
	// and @ktb/email-stub so outbound email (verification links, invites)
	// is written to the dev server log instead of being delivered. To send
	// real email to a local SMTP instead (e.g. mailpit in Docker), bind
	// SMTP_URL + EMAIL_FROM via .dev.vars — an explicit opt-in that wins
	// over EMAIL_STUB (see @ktb/email-smtp).
	// Unlike wrangler.jsonc it has NO "ai" binding: Workers AI has no local
	// simulator, so the binding forces a remote (authenticated) dev session.
	// AI resolution order instead: AI_STUB > AI_BASE_URL > env.AI — see
	// src/lib/ai.ts. Uncomment one to enable:
	//   "AI_STUB": "1" — canned responses, no server needed
	//   "AI_BASE_URL": "http://localhost:8080/v1" — OpenAI-compatible server
	//     (whisper.cpp / llama.cpp) exposing /audio/transcriptions and
	//     /chat/completions
	"vars": { "CAPTCHA_STUB": "1", "EMAIL_STUB": "1" },
	"r2_buckets": [{ "binding": "AUDIO_BUCKET", "bucket_name": "ktb-audio" }],
	"queues": {
		"producers": [{ "binding": "AUDIO_QUEUE", "queue": "ktb-transcription" }],
		"consumers": [{ "queue": "ktb-transcription" }],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ktb",
			// Replace with `bunx wrangler d1 create ktb` output before deploy.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "../../packages/db/drizzle",
		},
	],
}
